DATABASE_URL=postgresql://cima:cima@localhost:5434/cima
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Auth
BETTER_AUTH_SECRET=cima-secret-key-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# LLM config
LLM_PROVIDER=openai
LLM_CHAT_MODEL=gpt-4o
LLM_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_VOICE=marin
# Optional, overrides the default speaking style (gpt-*-tts models only)
OPENAI_TTS_INSTRUCTIONS=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Optional, overrides the default language hint for transcription
OPENAI_STT_PROMPT=

# Sansa / Health-Core service access
SANSA_API_URL=http://localhost:4444
SANSA_SERVICE_SECRET=
SANSA_USER_ID=

# Gemini MCP spike (Task 09.0): long random value, e.g. `openssl rand -hex 32`.
# The endpoint is /api/mcp/<secret>; it is disabled when empty.
# Production (Dokploy) sets MCP_SPIKE_SECRET; docker-compose.prod.yml maps it to this.
NUXT_MCP_SPIKE_SECRET=

